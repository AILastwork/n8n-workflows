    {
      "parameters": {
        "jsCode": "// First check if we have any input data\nconst input = $input.all();\nconsole.log(\"Input data structure:\", JSON.stringify(input, null, 2));\n\n// Check if we have the required data\nif (input && input.length > 0) {\n  const firstItem = input[0];\n  console.log(\"First item structure:\", JSON.stringify(firstItem, null, 2));\n  \n  if (firstItem.json) {\n    console.log(\"JSON structure:\", JSON.stringify(firstItem.json, null, 2));\n    \n    if (firstItem.json.comments && firstItem.json.comments.length > 0) {\n      console.log(\"Comment ID:\", firstItem.json.comments[0].commentId);\n    } else {\n      console.log(\"No comments found in the data\");\n    }\n    \n    if (firstItem.json.text) {\n      console.log(\"OpenAI response:\", firstItem.json.text);\n    } else {\n      console.log(\"No text property found in the data\");\n    }\n  }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
      "id": "b5156d29-0c7f-4cd9-a8ab-6f8aed869d78",
      "name": "Code1"
    },
    {
      "parameters": {
        "jsCode": "// Process YouTube comment data\nconst processedComments = [];\n\nfor (const item of $input.all()) {\n  if (item.json && item.json.items && Array.isArray(item.json.items)) {\n    for (const commentThread of item.json.items) {\n      // Debug the comment structure\n      console.log(\"Raw comment thread:\", JSON.stringify(commentThread, null, 2));\n      \n      if (commentThread.snippet && commentThread.snippet.topLevelComment) {\n        const comment = commentThread.snippet.topLevelComment.snippet;\n        const threadId = commentThread.id;\n        console.log(\"Using comment ID:\", threadId);\n        \n        processedComments.push({\n          commentId: commentThread.snippet.topLevelComment.id || commentThread.id,\n          threadId: commentThread.id,\n          videoId: commentThread.snippet.videoId,\n          authorDisplayName: comment.authorDisplayName,\n          authorChannelId: comment.authorChannelId ? comment.authorChannelId.value : null,\n          textDisplay: comment.textDisplay,\n          textOriginal: comment.textOriginal,\n          publishedAt: comment.publishedAt,\n          replyCount: commentThread.snippet.totalReplyCount || 0\n        });\n      }\n    }\n  }\n}\n\n// Return the processed data\nreturn [{json: { comments: processedComments }}];"
      },
