    {
      "parameters": {
        "functionCode": "// Split keywords string into array\nconst keywords = $input.item.json.keywords.split(',').map(k => k.trim());\nconst location = $input.item.json.location;\nconst businessName = $input.item.json.businessName;\n\n// Create items for each keyword\nreturn keywords.map(keyword => {\n  return {\n    json: {\n      businessName,\n      location,\n      keyword,\n      searchQuery: `${keyword} ${location}`\n    }\n  };\n});"
      },
      "name": "Process Keywords",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        620,
        240
      ],
      "id": "0df86a4d-8c98-4a0d-8bea-3818c80f91e1"
    },
    {
      "parameters": {
        "url": "=https://serpapi.com/search?engine=google&q={{ encodeURIComponent($json.searchQuery + ' ' + $json.businessName) }}&location={{ encodeURIComponent($json.location) }}&businessName={{ encodeURIComponent($json.businessName) }}&hl=en&gl=us&google_domain=google.com\n",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "serpApi",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Search API Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        800,
        240
      ],
      "id": "8c2f7bf6-a1a9-457a-88d5-673f79523ae3",
      "credentials": {
        "serpApi": {
          "id": "pEZAOswoqayaWXUZ",
          "name": "SerpAPI account"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "let rankPosition = 0;\nlet foundBusiness = false;\nconst businessName = $input.item.json.businessName.toLowerCase();\nconst keyword = $input.item.json.keyword;\nconst location = $input.item.json.location;\n\n// Extract organic search results\nconst organicResults = $input.item.json?.organic_results || [];\n\n// Look for the business name in organic results (up to position 20)\nfor (let i = 0; i < Math.min(organicResults.length, 20); i++) {\n  const result = organicResults[i];\n\n  // Convert all text to lowercase for case-insensitive comparison\n  const title = result.title ? result.title.toLowerCase() : \"\";\n  const snippet = result.snippet ? result.snippet.toLowerCase() : \"\";\n  const displayedLink = result.displayed_link ? result.displayed_link.toLowerCase() : \"\";\n  const source = result.source ? result.source.toLowerCase() : \"\";\n\n  // Check if business name appears in any of the fields\n  if (\n    title.includes(businessName) ||\n    snippet.includes(businessName) ||\n    displayedLink.includes(businessName) ||\n    source.includes(businessName)\n  ) {\n    rankPosition = i + 1;\n    foundBusiness = true;\n    break;\n  }\n}\n\n// Return adjusted output\nreturn {\n  json: {\n    businessName: $input.item.json.businessName,\n    keyword,\n    location,\n    date: new Date().toISOString().split('T')[0],\n    position: foundBusiness ? rankPosition : 'Not found in top 20',\n    resultType: foundBusiness ? 'Organic' : 'Not found'\n  }\n};\n"
      },
